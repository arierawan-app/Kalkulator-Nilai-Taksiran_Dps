# Salin file ini menjadi .env.local lalu isi nilainya.
# 1) AUTH_SECRET: buat dengan perintah: openssl rand -base64 32
AUTH_SECRET=

# 2) Kredensial Supabase untuk data akun satker (kata sandi & logo).
#    Ambil dari dashboard Supabase: Project Settings > API
#    (Project URL dan publishable/anon key).
SUPABASE_URL=
SUPABASE_ANON_KEY=
